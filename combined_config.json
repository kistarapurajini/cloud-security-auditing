
{
    "public_access": true,
    "encryption": false,
    "multi_factor_authentication": false,
    "unrestricted_network_access": true,
    "excessive_permissions": true,
    "logging_enabled": false,
    "secure_storage": false,
    "s3": {
        "public_acl_grants": ["AllUsers"],
        "public_bucket_policy": true,
        "public_access_block": {
            "block_public_acls": false,
            "ignore_public_acls": false,
            "block_public_policy": false,
            "restrict_public_buckets": false
        }
    },
    "tenant_access": {
        "access_rules": [
            {
                "source_tenant": "Tenant_A",
                "target_tenant": "Tenant_B",
                "allowed": true
            },
            {
                "source_tenant": "Tenant_B",
                "target_tenant": "Tenant_B",
                "allowed": true
            },
            {
                "source_tenant": "Tenant_C",
                "target_tenant": "Tenant_A",
                "allowed": false
            }
        ]
    }
}
